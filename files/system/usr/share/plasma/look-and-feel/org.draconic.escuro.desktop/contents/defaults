# Tema global "Draconic Escuro": cores, ícones, fontes (Fase 2) e
# tema do Plasma, papel de parede e layout dos painéis (Fase 3).

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=DraconicEscuro

[kdeglobals][Icons]
Theme=Draconic

[plasmarc][Theme]
name=draconic-escuro

[Wallpaper]
Image=Draconic

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[ksplashrc][KSplash]
Theme=org.kde.breeze.desktop
